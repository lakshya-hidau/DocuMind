# ─────────────────────────────────────────────────────────────────────────────
# DocuMind Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Required: Your HuggingFace API token
# Get one from https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_your_token_here

# Optional: User-Agent header for web scraping (WebBaseLoader)
USER_AGENT=DocuMind/1.0

# Optional: Comma-separated list of allowed CORS origins
# Leave as * for local development
# For production, set to your frontend domain e.g.: https://documind.yourdomain.com
ALLOWED_ORIGINS=*
