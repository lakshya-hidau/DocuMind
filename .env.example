# ─────────────────────────────────────────────────────────────────────────────
# DocuMind — Root .env.example
# Copy this to .env in the project root for production docker-compose usage.
# ─────────────────────────────────────────────────────────────────────────────

# The full URL where your backend API is deployed
# Used by docker-compose.prod.yml to bake the URL into the frontend build
VITE_API_URL=https://your-api-domain.com

# Your frontend's public URL — used for CORS restriction on the backend
FRONTEND_ORIGIN=https://your-frontend-domain.com
